# ============================================================
# AGROMATICA - Plantilla de Variables de Entorno
# Copia este archivo como .env y rellena con tus credenciales
# NUNCA subas el .env real a control de versiones
# ============================================================

# --- Conexión PostgreSQL ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=agrobio_db
DB_USER=postgres
DB_PASSWORD=julissa2318

# --- Pool de Conexiones ---
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Aplicación ---
APP_ENV=development          # development | production
APP_DEBUG=true
APP_CACHE_TTL=600            # segundos de caché para consultas
